{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>inseven/renovate-config"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
      {
        "matchManagers": [
          "git-submodules"
        ],
        "matchDepNames": [
          "device/nodemcu/nodemcu-firmware",
          "hardware/v1/pcb/libraries/Eagle-Libraries",
          "hardware/v1/pcb/libraries/SparkFun-Eagle-Libraries",
          "nodemcu-uploader"
        ],
        "enabled": false
      },
      {
        "matchManagers": [
          "npm"
        ],
        "matchUpdateTypes": [
          "minor",
          "patch"
        ],
        "automerge": true
      }
    ]
}
